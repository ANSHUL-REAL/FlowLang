{
  "name": "FlowLang",
  "version": "0.2.0",
  "fileExtensions": ["flow"],
  "keywords": [
    "let",
    "say",
    "if",
    "repeat",
    "for",
    "in",
    "func",
    "create",
    "id",
    "setText",
    "onClick",
    "style",
    "input",
    "and",
    "or",
    "true",
    "false"
  ],
  "operators": ["+", "-", "*", "/", "=", "==", "!=", ">", ">=", "<", "<=", ".."],
  "builtins": [
    "len",
    "sum",
    "mean",
    "median",
    "min",
    "max",
    "std",
    "variance",
    "percentile",
    "sort",
    "unique",
    "dot",
    "linspace",
    "normalize",
    "table",
    "column",
    "head",
    "select",
    "filterGt",
    "filterLt",
    "filterEq",
    "filterBetween",
    "sortBy",
    "rename",
    "describe"
  ],
  "pipeline": ["lexer", "parser", "interpreter", "visual-dom"],
  "examples": {
    "analytics": "let values = [2, 4, 6, 8]\nsay mean(values)\nsay percentile(values, 75)",
    "ui": "create \"button\" id run\nsetText run \"Run analysis\"\nonClick run {\n  say \"Running\"\n}"
  }
}
